    {
        "id": "06efd2d3e7760e8a",
        "type": "function",
        "z": "dfa7537204252f08",
        "name": "function 1",
        "func": "// 1. On récupère les valeurs déjà stockées ou on met 0 par défaut\nlet lat = context.get('lat') || 0;\nlet lon = context.get('lon') || 0;\n\n// 2. On regarde quel topic arrive et on met à jour la variable correspondante\nif (msg.topic === \"frigo/gps/lat\") {\n    lat = parseFloat(msg.payload);\n    context.set('lat', lat); // On enregistre en mémoire\n} \nelse if (msg.topic === \"frigo/gps/lng\") {\n    lon = parseFloat(msg.payload);\n    context.set('lon', lon); // On enregistre en mémoire\n}\n\n// 3. Si on a les deux coordonnées, on envoie l'objet à la WorldMap\nif (lat !== 0 && lon !== 0) {\n    msg.payload = {\n        name: \"Frigo_Medical\",\n        lat: lat,\n        lon: lon,\n        icon: \"medkit\",\n        color: \"red\",\n        layer: \"ESP32\"\n    };\n    return msg;\n}\n\n// Sinon on ne fait rien (on attend d'avoir les deux)\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 580,
        "wires": [
            [
                "d1e90733bd61c8dc"
            ]
        ]
    },
